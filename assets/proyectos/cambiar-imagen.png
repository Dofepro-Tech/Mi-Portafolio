  "browser": {
    "./util.inspect.js": false
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "unreleased": false,
    "commitLimit": false,
    "backfillLimit": false,
    "hideCredit": true
  },
  "publishConfig": {
    "ignore": [
      ".github/workflows",
      "./test-core-js.js"
    ]
  },
  "support": true,
  "engines": {
    "node": ">= 0.4"
