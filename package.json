{
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "resend": "^6.22.0"
  },
  "name": "portafolio",
  "version": "1.0.0",
  "description": "Portafolio de DofeproTech con proyectos filtrables, tema claro u oscuro, contacto por correo o WhatsApp y reseñas moderadas.",
  "main": "script.js",
  "devDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch",
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --minify",
    "start": "node server/server.js"
  },
  "keywords": [
    "portafolio",
